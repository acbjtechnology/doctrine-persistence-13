{
    "name": "acbjtechnology/doctrine-persistence-13",
    "type": "library",
    "description": "The Doctrine Persistence project is a set of shared interfaces and functionality that the different Doctrine object mappers share.",
    "keywords": [
        "persistence",
        "object",
        "mapper",
        "orm",
        "odm"
    ],
    "homepage": "https://gitlab.bizjournals.com/bizjournals/doctrine/doctrine-reflection-13",
    "license": "MIT",
    "authors": [
        {"name": "Guilherme Blanco", "email": "guilhermeblanco@gmail.com"},
        {"name": "Roman Borschel", "email": "roman@code-factory.org"},
        {"name": "Benjamin Eberlei", "email": "kontakt@beberlei.de"},
        {"name": "Jonathan Wage", "email": "jonwage@gmail.com"},
        {"name": "Johannes Schmitt", "email": "schmittjoh@gmail.com"},
        {"name": "Marco Pivetta", "email": "ocramius@gmail.com"}
    ],
    "require": {
        "php": ">=7.3",
        "doctrine/annotations": "^1.0",
        "doctrine/cache": "^1.0",
        "doctrine/collections": "^1.0",
        "doctrine/event-manager": "^1.0",
        "acbjtechnology/doctrine-reflection-12": "dev-main"
    },
    "require-dev": {
        "phpstan/phpstan": "^0.11",
        "doctrine/coding-standard": "^6.0",
        "phpunit/phpunit": "^7.0 || ^8.0 || ^9.0",
        "vimeo/psalm": "^3.11"
    },
    "conflict": {
        "doctrine/common": "<2.10@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": false,
    "autoload": {
        "psr-4": {
            "Doctrine\\Common\\": "lib/Doctrine/Common",
            "Doctrine\\Persistence\\": "lib/Doctrine/Persistence"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doctrine\\Tests\\": "tests/Doctrine/Tests",
            "Doctrine\\Tests_PHP74\\": "tests/Doctrine/Tests_PHP74"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "main",
            "dev-develop": "13-8-1-dev"
        }
    },
    "repositories" : [
        {
            "type":"package",
            "package": {
                "name": "acbjtechnology/doctrine-reflection-12",
                "version":"dev-main",
                "source": {
                    "url": "git@gitlab.bizjournals.com:bizjournals/doctrine/doctrine-reflection-12.git",
                    "type": "git",
                    "reference":"main"
                },
                "autoload": {
                    "psr-4": {
                        "Doctrine\\Common\\": "lib/Doctrine/Common"
                    }
                }
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    }
}
